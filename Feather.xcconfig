SPARROW_PROJECT_VERSION=1.0.2
SPARROW_PRODUCT_BUNDLE_IDENTIFIER=com.sparrow.app
SPARROW_DISAMBIGUATOR=${DEVELOPMENT_TEAM}
// Legacy aliases are retained for source compatibility; product metadata uses Sparrow values.
FEATHER_PROJECT_VERSION=$(SPARROW_PROJECT_VERSION)
FEATHER_PRODUCT_BUNDLE_IDENTIFIER=$(SPARROW_PRODUCT_BUNDLE_IDENTIFIER)
FEATHER_DISAMBIGUATOR=$(SPARROW_DISAMBIGUATOR)
AD_HOC_CODE_SIGNING_ALLOWED = YES

DEPLOYMENT_LOCATION = YES
DSTROOT = $(SRCROOT)/_build/
